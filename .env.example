# Local settings for temporal-credential-operations.
# Copy to .env.local (gitignored) and fill in. Never commit .env.local,
# certificates, keys, or API keys.

# --- Temporal Cloud Operations API ------------------------------------------
# API key for a user or service account with an account-level role
# (Global Admin). The demo scripts use it, from your shell only, to read and
# change the demo Namespace's accepted client CAs.
TEMPORAL_CLOUD_OPS_API_KEY=

# --- Demo Temporal Cloud Namespace ------------------------------------------
# Credential rotation demos need a Temporal Cloud Namespace dedicated to the
# demo. The demo adds and removes accepted client CAs on it, including
# removing the bootstrap CA below when it retires it, so do not use a
# Namespace any other client depends on.
#
# The Namespace must use mTLS authentication and accept the bootstrap CA
# below. Its gRPC address: <namespace>.<account>.tmprl.cloud:7233
TEMPORAL_DEMO_NAMESPACE_ADDRESS=

# Bootstrap client CA: a CA certificate (PEM) and its private key, generated
# outside Vault. Paths are absolute or relative to the repository root, and
# *.pem / *.key files are gitignored.
TEMPORAL_DEMO_CA_CERT_FILE=
TEMPORAL_DEMO_CA_KEY_FILE=
