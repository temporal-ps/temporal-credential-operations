# Alerts from the proposal's Alerts section, rendered into ConfigMap
# prometheus-rules by scripts/apply-settings.sh. ${...} values come from
# demo-settings.env. No Alertmanager is deployed; firing alerts show in the
# Prometheus UI under Alerts.
#
# Severity follows impact:
#   page    calls from a cluster are failing now
#   ticket  calls still succeed; a deadline is running (the proxy keeps
#           serving its last valid leaf until it expires)
groups:
  - name: temporal-proxy-certificates
    rules:
      - alert: TemporalProxyLeafRenewalStalled
        # Two refreshes missed: less than leaf TTL - 2 x refresh interval left.
        expr: (tmprl_proxy_tls_cert_expiry_timestamp_seconds{file="cert"} - time()) < ${RENEWAL_STALLED_SECONDS}
        for: 1m
        labels: {severity: ticket}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} leaf expires in {{ $value | humanizeDuration }}; ESO or Vault is not renewing it. Calls still succeed until then."
      - alert: TemporalProxyReloadFailed
        expr: increase(tmprl_proxy_tls_reloads_total{result="failure"}[10m]) > 0
        labels: {severity: ticket}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} rejected new certificate material and kept its previous leaf. Calls still succeed until that leaf expires."
      - alert: TemporalProxyMissing
        # The demo runs two proxy replicas per client namespace.
        expr: count by (namespace) (tmprl_proxy_tls_cert_expiry_timestamp_seconds{file="cert"}) < 2
        for: 2m
        labels: {severity: ticket}
        annotations:
          summary: "fewer proxies than expected report a loaded leaf in {{ $labels.namespace }}; the others still serve, and a rollover's gate cannot pass"
      - alert: TemporalProxyNoneServing
        # Every proxy Pod in a client namespace is down (for example crash
        # looping on an expired leaf). No proxy means no forwarding errors, so
        # this is the page for that case.
        expr: sum by (namespace) (up{job="temporal-proxy"}) == 0
        for: 1m
        labels: {severity: page}
        annotations:
          summary: "no Temporal Proxy is serving in {{ $labels.namespace }}; calls from it are failing"
      - alert: TemporalProxyForwardingErrors
        expr: increase(tmprl_proxy_router_forwarding_errors_total[5m]) > 0
        labels: {severity: page}
        annotations:
          summary: "{{ $labels.namespace }}/{{ $labels.pod }} is failing to forward calls to Temporal Cloud ({{ $labels.reason }})"
