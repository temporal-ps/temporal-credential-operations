# Demo timing settings. Not secrets. Edit, then apply to a running demo with
#   ./scripts/apply-settings.sh
# Any value can also be overridden in the repository-root .env.local.
#
# Durations take an s, m, or h suffix. These are demo values chosen so a
# rollover can be watched in a few minutes; production uses days for leaves
# and hours for refresh.

# How often ESO asks Vault for a new leaf (ExternalSecret refreshInterval).
# A routine rollover's verify step waits about this long plus 2 minutes.
ESO_REFRESH_INTERVAL=1m

# Lifetime of each leaf Vault signs (temporal-client role ttl and max_ttl).
# Must be at least 3x ESO_REFRESH_INTERVAL, so two missed refreshes still
# leave a valid leaf. It is also how long the demo survives ESO or Vault
# being unavailable, including the host sleeping: after a longer outage the
# proxies hold expired leaves until ./scripts/force-refresh.sh.
LEAF_TTL=5m

# Clock skew the retirement gate allows when deciding whether a loaded leaf
# was issued after the switch. Keep it far below ESO_REFRESH_INTERVAL: a leaf
# issued within this many seconds before the switch counts as new. The demo
# runs on one clock; production sets its measured clock-skew bound.
GATE_CLOCK_SKEW_SECONDS=5

# Lifetime of each new Vault issuer (the CA Temporal Cloud trusts).
ISSUER_TTL=8760h

# check-issuer-expiry.sh fails when the issuer expires within this many days.
ISSUER_LEAD_DAYS=30

# How long 06-retire.sh watches probe traffic after removing the old CA.
RETIRE_PROBE_SECONDS=30
